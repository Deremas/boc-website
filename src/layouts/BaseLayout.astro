---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SEO from "../components/layout/SEO.astro";
import Analytics from "../components/layout/Analytics.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} />
    <Analytics />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Blue Ocean Creatives",
      url: "https://blueoceancreatives.com",
    })} />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function parts(raw: string) {
        const plus = raw.endsWith("+");
        const unit = /m/i.test(raw) ? "M" : /k/i.test(raw) ? "K" : "";
        const target = Number(raw.replace(/[^0-9]/g, ""));
        const suffix = unit + (plus ? "+" : "");
        return { target, suffix, grouped: raw.includes(",") };
      }

      function label(value: number, grouped: boolean, suffix: string) {
        const rounded = Math.round(value);
        const body = grouped ? rounded.toLocaleString("en-US") : String(rounded);
        return body + suffix;
      }

      document.querySelectorAll<HTMLElement>("[data-count]").forEach((node) => {
        const raw = node.dataset.count ?? "";
        const { target, suffix, grouped } = parts(raw);
        if (!target || reduce) return;
        node.textContent = label(0, grouped, suffix);

        const run = () => {
          const start = performance.now();
          const duration = 1400;
          const frame = (now: number) => {
            const progress = Math.min(1, (now - start) / duration);
            const eased = 1 - (1 - progress) ** 3;
            node.textContent = label(target * eased, grouped, suffix);
            if (progress < 1) requestAnimationFrame(frame);
          };
          requestAnimationFrame(frame);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            run();
          },
          { threshold: 0.5 },
        );
        observer.observe(node);
      });

      if (!reduce) {
        const show = (node: Element) => {
          node.classList.add("is-in");
        };

        const reveal = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              show(entry.target);
              reveal.unobserve(entry.target);
            }
          },
          { threshold: 0.01, rootMargin: "0px 0px -40px 0px" },
        );

        const observe = (node: HTMLElement) => {
          reveal.observe(node);
          const rect = node.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          if (rect.top < vh * 0.98 && rect.bottom > 0) show(node);
        };

        const blocks = document.querySelectorAll<HTMLElement>("main > section, main > .container");
        blocks.forEach((block, index) => {
          if (index === 0) return;
          block.classList.add("reveal");
          block.style.setProperty("--reveal-delay", `${Math.min(index, 6) * 40}ms`);
          observe(block);
        });

        const cards = document.querySelectorAll<HTMLElement>(
          [
            ".why-grid > .card",
            ".result-grid > a.card",
            ".feature-grid > .card",
            ".service-grid > .card",
            ".service-grid > li.card",
            ".work-grid > a.card",
            ".practice-grid > .card",
            ".health-strip > .card",
            ".showcase-strip > a.card",
            ".card-strip > .card",
            ".card-strip > a.card",
            ".steps > .step",
            ".result-metric-grid > .card",
            ".project-cards > .card",
            ".proof-grid > .proof-stat",
            ".product-frame",
            ".leader-grid > .leader-card",
            ".location-grid > .location-card",
            ".pain-grid > .card",
            ".faq details",
            ".module-list > li",
            ".card-soft",
            ".reach-card",
            ".contact-panel",
            ".case-metrics > .card",
            ".gallery-grid > *",
            ".disclose-body > .card",
            ".disclose-body > li.card",
            ".quote-card",
            ".org-node",
            ".mission-card",
            ".vision-card",
            ".value-card",
            ".ethiopia-card",
            ".ethiopia-item",
            ".role-card",
            ".split > .card",
            ".verified-results-panel",
            ".project-card",
            ".glance > .glance-cell",
            ".case-metrics > .metric-cell",
            ".gallery-grid > .gallery-shot",
            ".chips > .chip",
          ].join(", "),
        );
        cards.forEach((card, index) => {
          card.classList.add("card-reveal");
          card.style.setProperty("--reveal-delay", `${(index % 6) * 70}ms`);
          observe(card);
        });

        // Never leave content stuck invisible if IO missed it
        window.setTimeout(() => {
          document
            .querySelectorAll(".reveal:not(.is-in), .card-reveal:not(.is-in)")
            .forEach(show);
        }, 1800);

        document.addEventListener("toggle", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLDetailsElement) || !target.open) return;
          target
            .querySelectorAll(".reveal:not(.is-in), .card-reveal:not(.is-in)")
            .forEach(show);
        }, true);
      }
    </script>
  </body>
</html>
