---
interface Client {
  name: string;
  logo?: string;
  color?: boolean;
  zoom?: boolean;
  website?: string;
}

interface Props {
  clients: Client[];
  marquee?: boolean;
}

const { clients, marquee = false } = Astro.props;
/** Marquee only shows clients with logos — blank text tiles look broken while scrolling. */
const visible = marquee ? clients.filter((client) => Boolean(client.logo)) : clients;
---

{
  marquee ? (
    <div class="logo-marquee" data-motion="marquee">
      <div class="logo-marquee-track">
        {[false, true].map((clone) => (
          <div class="logo-marquee-set" aria-hidden={clone ? "true" : undefined}>
            {visible.map((client) => {
              const tile = (
                <img
                  src={client.logo}
                  alt={clone ? "" : `${client.name} logo`}
                  width="160"
                  height="72"
                  loading={clone ? "lazy" : "eager"}
                  decoding="async"
                  fetchpriority={clone ? "low" : "auto"}
                />
              );
              const className = ["logo-tile", client.color && "logo-color", client.zoom && "logo-zoom"];
              return client.website ? (
                <a
                  class:list={className}
                  href={client.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex={clone ? -1 : undefined}
                >
                  {tile}
                </a>
              ) : (
                <div class:list={className}>{tile}</div>
              );
            })}
          </div>
        ))}
      </div>
    </div>
  ) : (
    <div class="logo-wall">
      {visible.map((client) => {
        const tile = client.logo ? (
          <img
            src={client.logo}
            alt={`${client.name} logo`}
            width="160"
            height="72"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span>{client.name}</span>
        );
        const className = ["logo-tile", client.color && "logo-color", client.zoom && "logo-zoom"];
        return client.website ? (
          <a class:list={className} href={client.website} target="_blank" rel="noopener noreferrer">
            {tile}
          </a>
        ) : (
          <div class:list={className}>{tile}</div>
        );
      })}
    </div>
  )
}
