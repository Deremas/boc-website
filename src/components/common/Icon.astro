---
interface Props {
  name: "phone" | "mail" | "pin" | "download" | "facebook" | "instagram" | "tiktok" | "linkedin" | "telegram";
}

const { name } = Astro.props;
const brand = name === "facebook" || name === "instagram" || name === "tiktok" || name === "linkedin" || name === "telegram";
---

<svg class:list={["icon", { "icon-brand": brand, "icon-stroke": name === "instagram", "download-mark": name === "download" }]} width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
  {
    name === "phone" && (
      <path d="M7 3h3l1.5 4-2 1.2a12 12 0 0 0 6.3 6.3L17 12.5 21 14v3a2 2 0 0 1-2.2 2A16 16 0 0 1 5 7.2 2 2 0 0 1 7 3z" />
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
        <path d="M4 7l8 6 8-6" />
      </>
    )
  }
  {
    name === "download" && <path d="M12 4v10M8 10l4 4 4-4M5 19h14" />
  }
  {
    name === "pin" && (
      <>
        <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z" />
        <circle cx="12" cy="10" r="2.2" />
      </>
    )
  }
  {
    name === "facebook" && (
      <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v8h4v-8h3l1-4h-4V8a1 1 0 0 1 1-1z" />
    )
  }
  {
    name === "instagram" && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="5" />
        <circle cx="12" cy="12" r="3.6" />
        <circle class="dot" cx="17.2" cy="6.8" r="1" />
      </>
    )
  }
  {
    name === "tiktok" && (
      <g transform="translate(2.4 2.2) scale(0.8)">
        <path class="tint-cyan" transform="translate(-1.15 0.95)" d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.77 1.52V6.76a4.85 4.85 0 0 1-1-.07z" />
        <path class="tint-pink" transform="translate(1.15 -0.85)" d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.77 1.52V6.76a4.85 4.85 0 0 1-1-.07z" />
        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.77 1.52V6.76a4.85 4.85 0 0 1-1-.07z" />
      </g>
    )
  }
  {
    name === "linkedin" && (
      <>
        <rect x="4" y="9" width="3.2" height="10" />
        <circle cx="5.6" cy="5.6" r="1.6" fill="currentColor" stroke="none" />
        <path d="M11 9h3v1.6a3.4 3.4 0 0 1 2.8-1.5c2.2 0 3.2 1.4 3.2 3.8V19H17v-4.2c0-1.2-.4-2-1.5-2s-1.7.8-1.7 2V19H11z" />
      </>
    )
  }
  {name === "telegram" && <path d="M9.04 15.3 8.7 19.6c.4 0 .6-.2.8-.4l2-1.9 4.1 3c.8.4 1.3.2 1.5-.7l2.7-12.7c.3-1.1-.4-1.6-1.2-1.3L3.3 10.1c-1.1.4-1.1 1-.2 1.3l4.6 1.4 10.6-6.7c.5-.3 1-.1.6.2" />}
</svg>

<style>
  .icon {
    display: block;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-brand,
  .icon-brand path,
  .icon-brand rect,
  .icon-brand circle {
    fill: currentColor;
    stroke: none;
  }

  .icon-brand.icon-stroke,
  .icon-brand.icon-stroke path,
  .icon-brand.icon-stroke rect,
  .icon-brand.icon-stroke circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .icon-brand.icon-stroke .dot {
    fill: currentColor;
    stroke: none;
  }

  .icon-brand .tint-cyan {
    fill: #25f4ee;
  }

  .icon-brand .tint-pink {
    fill: #fe2c55;
  }
</style>
