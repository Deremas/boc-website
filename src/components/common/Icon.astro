---
interface Props {
  name:
    | "phone"
    | "mail"
    | "pin"
    | "download"
    | "external"
    | "book"
    | "exam"
    | "course"
    | "tutor"
    | "camera"
    | "planner"
    | "feed"
    | "ads"
    | "brand"
    | "stack"
    | "boxes"
    | "industry"
    | "code"
    | "languages"
    | "chart"
    | "facebook"
    | "instagram"
    | "tiktok"
    | "linkedin"
    | "telegram";
}

const { name } = Astro.props;
const brand =
  name === "facebook" ||
  name === "instagram" ||
  name === "tiktok" ||
  name === "linkedin" ||
  name === "telegram";
const feature =
  name === "book" ||
  name === "exam" ||
  name === "course" ||
  name === "tutor" ||
  name === "camera" ||
  name === "planner" ||
  name === "feed" ||
  name === "ads" ||
  name === "brand" ||
  name === "stack" ||
  name === "boxes" ||
  name === "industry" ||
  name === "code" ||
  name === "languages" ||
  name === "chart" ||
  name === "pin";
---

<svg
  class:list={[
    "icon",
    {
      "icon-brand": brand,
      "icon-stroke": name === "instagram",
      "download-mark": name === "download",
      "external-mark": name === "external",
      "feature-mark": feature,
    },
  ]}
  width="18"
  height="18"
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  {
    name === "phone" && (
      <path d="M7 3h3l1.5 4-2 1.2a12 12 0 0 0 6.3 6.3L17 12.5 21 14v3a2 2 0 0 1-2.2 2A16 16 0 0 1 5 7.2 2 2 0 0 1 7 3z" />
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
        <path d="M4 7l8 6 8-6" />
      </>
    )
  }
  {name === "download" && <path d="M12 4v10M8 10l4 4 4-4M5 19h14" />}
  {name === "external" && (
    <>
      <path d="M14 5h5v5" />
      <path d="M10 14 19 5" />
      <path d="M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
    </>
  )}
  {
    name === "pin" && (
      <>
        <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z" />
        <circle cx="12" cy="10" r="2.2" />
      </>
    )
  }
  {
    name === "book" && (
      <>
        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z" />
        <path d="M4 5.5v16" />
      </>
    )
  }
  {
    name === "exam" && (
      <>
        <rect x="5" y="3.5" width="14" height="17" rx="2" />
        <path d="M9 8h6M9 12h6M9 16h3" />
      </>
    )
  }
  {
    name === "course" && (
      <>
        <path d="M4 7.5 12 4l8 3.5-8 3.5z" />
        <path d="M4 7.5v7.5L12 19l8-4V7.5" />
        <path d="M12 11v8" />
      </>
    )
  }
  {
    name === "tutor" && (
      <>
        <path d="M5 18v-1.5A3.5 3.5 0 0 1 8.5 13h3A3.5 3.5 0 0 1 15 16.5V18" />
        <circle cx="10" cy="8" r="3" />
        <path d="M17 11h4M19 9v4" />
      </>
    )
  }
  {
    name === "camera" && (
      <>
        <path d="M4 8.5h3l1.5-2h7l1.5 2h3v10H4z" />
        <circle cx="12" cy="13" r="3.2" />
      </>
    )
  }
  {
    name === "planner" && (
      <>
        <rect x="4" y="5" width="16" height="15" rx="2" />
        <path d="M8 3.5v3M16 3.5v3M4 10h16" />
        <path d="M8 14h2M12 14h2M16 14h.01M8 17h2M12 17h2" />
      </>
    )
  }
  {
    name === "feed" && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="3" />
        <path d="M8 9h8M8 12h8M8 15h5" />
      </>
    )
  }
  {
    name === "ads" && (
      <>
        <path d="M4 12V8.5A2.5 2.5 0 0 1 6.5 6H14l6 6-6 6H6.5A2.5 2.5 0 0 1 4 15.5z" />
        <path d="M14 6v12" />
      </>
    )
  }
  {
    name === "brand" && (
      <>
        <circle cx="12" cy="12" r="8" />
        <circle cx="12" cy="12" r="3" />
        <path d="M12 4v2.5M12 17.5V20M4 12h2.5M17.5 12H20" />
      </>
    )
  }
  {
    name === "stack" && (
      <>
        <path d="M4 8.5 12 5l8 3.5-8 3.5z" />
        <path d="M4 12.5 12 16l8-3.5" />
        <path d="M4 16.5 12 20l8-3.5" />
      </>
    )
  }
  {
    name === "boxes" && (
      <>
        <path d="M4 8.5 12 4l8 4.5v9L12 22 4 17.5z" />
        <path d="M12 13v9M4 8.5 12 13l8-4.5" />
      </>
    )
  }
  {
    name === "industry" && (
      <>
        <path d="M3 20h18" />
        <path d="M5 20V10l5 3V10l5 3V8h4v12" />
      </>
    )
  }
  {
    name === "code" && (
      <>
        <path d="M8 7 3.5 12 8 17" />
        <path d="M16 7l4.5 5L16 17" />
        <path d="M13.5 5.5 10.5 18.5" />
      </>
    )
  }
  {
    name === "languages" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M4.5 12h15" />
        <path d="M12 3.5c2.4 2.6 3.6 5.4 3.6 8.5S14.4 17.9 12 20.5C9.6 17.9 8.4 15.1 8.4 12S9.6 6.1 12 3.5z" />
      </>
    )
  }
  {
    name === "chart" && (
      <>
        <path d="M4 19h16" />
        <path d="M7 16V10M12 16V7M17 16v-5" />
      </>
    )
  }
  {
    name === "facebook" && (
      <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v8h4v-8h3l1-4h-4V8a1 1 0 0 1 1-1z" />
    )
  }
  {
    name === "instagram" && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="5" />
        <circle cx="12" cy="12" r="3.6" />
        <circle class="dot" cx="17.2" cy="6.8" r="1" />
      </>
    )
  }
  {
    name === "tiktok" && (
      <g transform="translate(2.4 2.2) scale(0.8)">
        <path
          class="tint-cyan"
          transform="translate(-1.15 0.95)"
          d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.77 1.52V6.76a4.85 4.85 0 0 1-1-.07z"
        />
        <path
          class="tint-pink"
          transform="translate(1.15 -0.85)"
          d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.77 1.52V6.76a4.85 4.85 0 0 1-1-.07z"
        />
        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.77 1.52V6.76a4.85 4.85 0 0 1-1-.07z" />
      </g>
    )
  }
  {
    name === "linkedin" && (
      <>
        <rect x="4" y="9" width="3.2" height="10" />
        <circle cx="5.6" cy="5.6" r="1.6" fill="currentColor" stroke="none" />
        <path d="M11 9h3v1.6a3.4 3.4 0 0 1 2.8-1.5c2.2 0 3.2 1.4 3.2 3.8V19H17v-4.2c0-1.2-.4-2-1.5-2s-1.7.8-1.7 2V19H11z" />
      </>
    )
  }
  {
    name === "telegram" && (
      <path d="M9.04 15.3 8.7 19.6c.4 0 .6-.2.8-.4l2-1.9 4.1 3c.8.4 1.3.2 1.5-.7l2.7-12.7c.3-1.1-.4-1.6-1.2-1.3L3.3 10.1c-1.1.4-1.1 1-.2 1.3l4.6 1.4 10.6-6.7c.5-.3 1-.1.6.2" />
    )
  }
</svg>

<style>
  .icon {
    display: block;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-brand,
  .icon-brand path,
  .icon-brand rect,
  .icon-brand circle {
    fill: currentColor;
    stroke: none;
  }

  .icon-brand.icon-stroke,
  .icon-brand.icon-stroke path,
  .icon-brand.icon-stroke rect,
  .icon-brand.icon-stroke circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .icon-brand.icon-stroke .dot {
    fill: currentColor;
    stroke: none;
  }

  .icon-brand .tint-cyan {
    fill: #25f4ee;
  }

  .icon-brand .tint-pink {
    fill: #fe2c55;
  }
</style>
