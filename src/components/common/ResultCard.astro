---
interface Props {
  value: string;
  label: string;
  client: string;
  href: string;
}

const { value, label, client, href } = Astro.props;
---

<a class="card card-link result-card" href={href} data-track="case-study">
  <strong>{value}</strong>
  <span>{label}</span>
  <em>{client}</em>
</a>
