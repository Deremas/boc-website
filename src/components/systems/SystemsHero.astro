---
import Button from "../common/Button.astro";
---

<div class="container hero">
  <div>
    <p class="eyebrow">Business systems & software</p>
    <h1>One system for your whole operation.</h1>
    <p class="lede">
      Production, inventory, procurement, sales, people and finance on one platform — built in Ethiopia for how Ethiopian companies actually work.
    </p>
    <div class="btn-row">
      <Button href="/contact?interest=Blue%20Ocean%20ERP%20demo" track="erp-demo">Book a live demo</Button>
      <Button href="/work" variant="secondary">See client projects</Button>
    </div>
  </div>
  <div class="product-frame" aria-label="Blue Ocean ERP summary">
    <p class="eyebrow">Blue Ocean ERP</p>
    <h2>329 features · 21 modules</h2>
    <div class="module-pills">
      <span>Production</span>
      <span>Inventory</span>
      <span>Procurement</span>
      <span>Sales</span>
      <span>Finance</span>
      <span>Payroll</span>
    </div>
  </div>
</div>
