---
import SectionHeading from "../common/SectionHeading.astro";
import { painPoints } from "../../data/services";
---

<section class="section-tint">
  <div class="container">
    <SectionHeading eyebrow="Sound familiar?" title="The gaps we get called about." />
    <ul class="service-grid" style="list-style:none; padding:0; margin:0;">
      {painPoints.map((point) => <li class="card"><h3>{point}</h3></li>)}
    </ul>
  </div>
</section>
