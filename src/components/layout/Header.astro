---
import { navigation, talkHref } from "../../data/navigation";
import MobileMenu from "./MobileMenu";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="Blue Ocean Creatives, home">
      <img src="/logos/blue-ocean-logo.png" alt="Blue Ocean Creatives" width="168" height="72" />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      {
        navigation.map((item) => (
          <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-primary header-cta" href={talkHref}>Talk to us</a>
    </nav>
    <div class="header-actions">
      <a class="btn btn-primary header-cta mobile-only-cta" href={talkHref}>Talk to us</a>
      <MobileMenu client:load links={[...navigation]} />
    </div>
  </div>
</header>

<style>
  .header-actions {
    display: none;
  }

  @media (max-width: 1024px) {
    .desktop-nav {
      display: none;
    }

    .header-actions {
      display: flex;
    }
  }
</style>
