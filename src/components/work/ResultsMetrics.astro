---
interface Props {
  metrics: { value: string; label: string }[];
  source?: string;
}

const { metrics, source } = Astro.props;
---

{
  metrics.length > 0 && (
    <div class="metrics">
      {metrics.map((metric) => (
        <article>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </article>
      ))}
    </div>
  )
}
{source && <p class="caption">{source}</p>}
