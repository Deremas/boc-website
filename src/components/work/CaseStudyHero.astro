---
import Icon from "../common/Icon.astro";
import Button from "../common/Button.astro";

interface Props {
  title: string;
  sector: string;
  location: string;
  services: string[];
  image?: string;
  website?: string;
  headline: string;
}

const { title, sector, location, services, image, website, headline } = Astro.props;
const siteLabel = website?.replace(/^https?:\/\//, "").replace(/\/$/, "");
const isLogo = Boolean(image?.startsWith("/logos/"));
---

<section class:list={["case-hero", { "case-hero-logo": isLogo }]}>
  <div class="container hero case-hero-grid">
    <div class="case-hero-copy">
      <p class="eyebrow">{sector}{location ? ` · ${location}` : ""}</p>
      <h1>{title}</h1>
      <p class="lede">{headline}</p>
      <div class="chips">
        {services.map((service) => <span class="chip">{service}</span>)}
      </div>
      {
        website && siteLabel && (
          <div class="btn-row" style="margin-top: 18px;">
            <Button href={website} variant="secondary" external>
              Visit {siteLabel}<Icon name="external" />
            </Button>
          </div>
        )
      }
    </div>
    {
      image && (
        isLogo ? (
          <div class="case-logo-panel" aria-hidden="true">
            <img class="case-logo-img" src={image} alt="" width="720" height="220" />
          </div>
        ) : (
          <img class="frame-photo" src={image} alt={title} width="960" height="640" />
        )
      )
    }
  </div>
</section>
