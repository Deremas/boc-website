---
interface Props {
  title: string;
  sector: string;
  location: string;
  services: string[];
  image?: string;
  headline: string;
}

const { title, sector, location, services, image, headline } = Astro.props;
---

<div class="container hero">
  <div>
    <p class="eyebrow">{sector}{location ? ` · ${location}` : ""}</p>
    <h1>{title}</h1>
    <p class="lede">{headline}</p>
    <div class="chips">
      {services.map((service) => <span class="chip">{service}</span>)}
    </div>
  </div>
  {
    image && (
      <img class="frame-photo" src={image} alt={title} width="960" height="640" />
    )
  }
</div>
