---
interface Props {
  title: string;
  sector: string;
  location: string;
  services: string[];
  image?: string;
  website?: string;
  headline: string;
}

const { title, sector, location, services, image, website, headline } = Astro.props;
const siteLabel = website?.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<div class="container hero">
  <div>
    <p class="eyebrow">{sector}{location ? ` · ${location}` : ""}</p>
    <h1>{title}</h1>
    <p class="lede">{headline}</p>
    <div class="chips">
      {services.map((service) => <span class="chip">{service}</span>)}
    </div>
    {
      website && siteLabel && (
        <p class="hero-site">
          <a class="text-link" href={website} target="_blank" rel="noopener noreferrer">
            {siteLabel}
          </a>
        </p>
      )
    }
  </div>
  {
    image && (
      <img
        class:list={["frame-photo", { "hero-logo": image.startsWith("/logos/") }]}
        src={image}
        alt={title}
        width="960"
        height="640"
      />
    )
  }
</div>
