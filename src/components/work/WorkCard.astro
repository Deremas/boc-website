---
interface Props {
  href: string;
  title: string;
  sector: string;
  category: string | readonly string[];
  headlineResult: string;
  image?: string;
}

const { href, title, sector, category, headlineResult, image } = Astro.props;
const categories = Array.isArray(category) ? category : [category];
const external = href.startsWith("http");
const logo = image?.startsWith("/logos/");
---

<a
  class="card work-card"
  href={href}
  data-work-card
  data-category={categories.join(" ")}
  data-track="case-study"
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {
    image ? (
      <img class:list={[{ "work-card-logo": logo }]} src={image} alt="" loading="lazy" />
    ) : (
      <div class="work-card-panel">
        <strong>{title}</strong>
      </div>
    )
  }
  <div class="work-card-body">
    {image && <h3>{title}</h3>}
    <p class="eyebrow">{sector}</p>
    <p class="work-result">{headlineResult}</p>
  </div>
</a>
