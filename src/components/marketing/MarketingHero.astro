---
import Button from "../common/Button.astro";
---

<div class="container hero">
  <div>
    <p class="eyebrow">Digital marketing & social media</p>
    <h1>Marketing that builds brands and brings in customers.</h1>
    <p class="lede">
      Strategy, content, video, hosts and paid ads — created by our in-house studio and regional teams, and measured against real results.
    </p>
    <div class="btn-row">
      <Button href="/contact" track="proposal">Get a marketing proposal</Button>
      <Button href="#verified-results" variant="secondary">See our results</Button>
    </div>
  </div>
  <div class="hero-visual hero-mark">
    <img
      src="/images/marketing/lavish-instagram.png"
      alt="Lavish Medical Spa on Instagram"
      width="1024"
      height="819"
    />
  </div>
</div>
