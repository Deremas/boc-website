---
import SectionHeading from "../common/SectionHeading.astro";
import { showcase } from "../../data/services";
---

<section>
  <div class="container">
    <SectionHeading title="From the studio and the field." />
    <div class="card-strip showcase-strip" role="list">
      {
        showcase.map((item) => (
          <a class="card work-card showcase-card" href={item.href} role="listitem">
            <div class="showcase-visual">
              <img src={item.image} alt="" loading="lazy" />
            </div>
            <div class="work-card-body">
              <h3>{item.title}</h3>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .showcase-strip {
    --strip-cols: 3;
  }
</style>
