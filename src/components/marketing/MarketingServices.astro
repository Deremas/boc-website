---
import SectionHeading from "../common/SectionHeading.astro";
import { marketingServices } from "../../data/services";
---

<section>
  <div class="container">
    <SectionHeading title="What the social media wing delivers." />
    <div class="service-grid">
      {
        marketingServices.map((service) => (
          <article class="card">
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
