---
import SectionHeading from "../common/SectionHeading.astro";
import TestimonialCarousel from "./TestimonialCarousel";
import { getCollection } from "astro:content";

const order = [
  "builders",
  "apex",
  "lavish",
  "fana",
  "wow-energy",
  "peniel",
  "evolve",
  "konel",
  "nova-water",
  "vector",
  "ag-grace",
];
const quotes = (await getCollection("testimonials"))
  .filter((entry) => entry.data.pages.includes("home"))
  .sort((a, b) => {
    const rank = (id: string) => {
      const place = order.indexOf(id);
      return place === -1 ? order.length : place;
    };
    return rank(a.id) - rank(b.id);
  })
  .map((entry) => entry.data);
---

<section class="section-tint">
  <div class="container">
    <SectionHeading
      eyebrow="From signed reference letters"
      title="What clients put in writing."
    />
    <TestimonialCarousel client:visible items={quotes} />
  </div>
</section>
