---
import Button from "../common/Button.astro";
import Icon from "../common/Icon.astro";
import { company } from "../../data/company";
---

<section class="hero-band">
  <div class="hero-band-media" aria-hidden="true">
    <img
      src="/images/office/wide-20.webp"
      alt=""
      width="1024"
      height="675"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="container hero hero-on-media">
    <div class="rise">
      <p class="eyebrow">Digital marketing · Business systems · Addis Ababa, Dire Dawa, Adama</p>
      <h1>Systems that run your business. <span class="line-accent">Stories that grow it.</span></h1>
      <p class="lede">
        We manage 50+ social media accounts for Ethiopian brands and build the ERP and business systems 100+ companies run on — one accountable team, on the ground in three cities.
      </p>
      <div class="btn-row">
        <Button href="/contact" track="proposal">Get a marketing proposal</Button>
        <Button href="/contact?interest=Blue%20Ocean%20ERP%20demo" variant="ghost-light" track="erp-demo">
          Book an ERP demo
        </Button>
      </div>
      <p class="hero-profile">
        <a
          class="text-link profile-link profile-link-on-dark"
          href={company.profilePdf}
          data-track="profile-download"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="download" />Company profile (PDF)
        </a>
      </p>
    </div>
  </div>
</section>
