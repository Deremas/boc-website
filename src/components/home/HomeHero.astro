---
import Button from "../common/Button.astro";
---

<div class="container hero">
  <div class="rise">
    <p class="eyebrow">Digital marketing · Business systems · Addis Ababa, Dire Dawa, Adama</p>
    <h1>Systems that run your business. <span class="line-accent">Stories that grow it.</span></h1>
    <p class="lede">
      We manage 50+ social media accounts for Ethiopian brands and build the ERP and business systems 100+ companies run on — one accountable team, on the ground in three cities.
    </p>
    <div class="btn-row">
      <Button href="/contact" track="proposal">Get a marketing proposal</Button>
      <Button href="/contact?interest=Blue%20Ocean%20ERP%20demo" variant="secondary" track="erp-demo">
        Book an ERP demo
      </Button>
    </div>
  </div>
  <div class="hero-visual">
    <img
      src="/images/office/wide-20.jpg"
      alt="Members of the Blue Ocean Creatives team"
      width="1024"
      height="675"
    />
    <div class="proof-badge">
      <strong data-count="37M+">37M+</strong>
      <span>views across four flagship accounts in 12 months</span>
    </div>
  </div>
</div>
