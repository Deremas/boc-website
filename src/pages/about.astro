---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/common/Button.astro";
import CTA from "../components/common/CTA.astro";
import { company, digitalEthiopia, leadership, mission, org, story, teamGroups, timeline, values, vision } from "../data/company";

function personName(name: string) {
  const nick = name.match(/\(([^)]+)\)$/);
  if (!nick || nick.index === undefined) return { given: name, nick: "" };
  return { given: name.slice(0, nick.index).trim(), nick: `(${nick[1]})` };
}

function showRole(role: string) {
  return role !== "Video editor" && role !== "Social media manager and host";
}
---

<BaseLayout
  title="About Blue Ocean Creatives | Blue Pixel Trading PLC, Addis Ababa"
  description="Founded in April 2023, Blue Ocean Creatives runs digital marketing and builds business systems for Ethiopian companies, with 23+ staff in Addis Ababa, Dire Dawa and Adama."
  image="/images/office/wide-20.webp"
>
  <div class="container hero">
    <div>
      <p class="eyebrow">About</p>
      <h1>We help Ethiopian businesses run better and grow faster.</h1>
      <p class="lede">
        {company.legalName}, trading as {company.name}. Founded in {company.established}. {company.staff} people in Addis Ababa, Dire Dawa and Adama.
      </p>
    </div>
    <img class="frame-photo" src="/images/office/wide-20.webp" alt="Blue Ocean Creatives team" width="1024" height="675" />
  </div>
  <section class="section-tint">
    <div class="container">
      <h2>Our story</h2>
      <div class="story-layout">
        <div class="prose">
          {story.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="timeline" data-timeline>
          {timeline.map((item, index) => (
            <article class="timeline-item" style={`--step: ${index}`}>
              <p class="story-year"><span>{item.year}</span></p>
              <p class="timeline-text">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section>
    <div class="container split">
      <article class="card mission-card">
        <p class="eyebrow">Mission</p>
        <h2>{mission}</h2>
      </article>
      <article class="card card-dark vision-card">
        <p class="eyebrow">Vision</p>
        <h2>{vision}</h2>
      </article>
    </div>
    <div class="container why-grid values-grid" style="margin-top: 18px;">
      {values.map((value) => (
        <article class="card value-card">
          <h3>{value.title}</h3>
          <p>{value.text}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section-tint">
    <div class="container">
      <h2>Leadership</h2>
      <div class="leader-grid" style="margin-top: 20px;">
        {leadership.map((person) => (
          <article class="leader-card">
            {person.image ? (
              <img src={person.image} alt={person.name} width="640" height="640" />
            ) : (
              <div class="avatar-fallback" aria-hidden="true">{person.name.split(" ").map((part) => part[0]).slice(0, 2).join("")}</div>
            )}
            <div>
              <h3>{person.name}</h3>
              <p class="leader-role">{person.role}</p>
              <p>{person.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <h2>How we are organised</h2>
      <div class="org" style="margin-top: 20px;" role="list" aria-label="Company structure">
        <div class="org-unit org-root" role="listitem">
          <span class="org-title">{org.ceo.title}</span>
          <span class="org-detail">{org.ceo.detail}</span>
        </div>
        <span class="org-stem" aria-hidden="true"></span>
        <div class="org-tier" role="presentation">
          {org.reports.map((role) => (
            <div class="org-unit" role="listitem">
              <span class="org-title">{role.title}</span>
              <span class="org-detail">{role.detail}</span>
            </div>
          ))}
        </div>
        <span class="org-stem" aria-hidden="true"></span>
        <div class="org-tier org-tier-wings" role="presentation">
          {org.wings.map((wing) => (
            <div class="org-unit" role="listitem">
              <span class="org-title">{wing.title}</span>
              <span class="org-detail">{wing.detail}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="team-section">
        <h3>Teams by wing</h3>
        <div class="team-groups">
          {
            teamGroups.map((group) => (
              <div>
                <h4>{group.wing}</h4>
                <div
                  class:list={[
                    "role-grid",
                    { "cols-3": group.people.length === 3, "cols-1": group.people.length === 1 },
                  ]}
                >
                  {group.people.map((person) => {
                    const { given, nick } = personName(person.name);
                    return (
                      <article class="role-card">
                        {person.image && <img src={person.image} alt={person.name} width="480" height="600" />}
                        <strong>
                          <span class="person-name">{given}</span>
                          {nick && <>{" "}<span class="person-nick">{nick}</span></>}
                        </strong>
                        {showRole(person.role) && <p>{person.role}</p>}
                      </article>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section class="section-tint">
    <div class="container">
      <h2>Where we work</h2>
      <div class="location-grid" style="margin-top: 20px;">
        {company.locations.map((location) => (
          <article class="location-card">
            <p class="eyebrow">{location.staff} staff</p>
            <h3>{location.city}</h3>
            <p>{location.role}</p>
            <p>{location.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <div class="card card-dark ethiopia-card">
        <p class="eyebrow">Digital Ethiopia 2030</p>
        <h2>Our contribution.</h2>
        <div class="service-grid" style="margin-top: 18px;">
          {digitalEthiopia.map((item) => (
            <div class="ethiopia-item">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section-tint">
    <div class="container split">
      <div>
        <h2>Credentials</h2>
        <ul>
          <li>Registered name: {company.legalName}</li>
          <li>Trade name: {company.name}</li>
          <li>Established {company.established}</li>
        </ul>
        <div style="margin-top: 18px;">
          <Button href={company.profilePdf} variant="secondary" track="profile-download" external>Download company profile</Button>
        </div>
      </div>
      <article class="card reach-card">
        <h2>Reach us</h2>
        <p>
          <span class="reach-label">Email:</span>
          <a class="text-link" href={`mailto:${company.email}`}>{company.email}</a> <br>
          <span class="reach-label">Phone:</span>
          <a class="text-link" href={`tel:${company.phoneTel}`}>{company.phone}</a>
        </p>
        <p style="margin-top: 10px;">
          <a class="text-link" href="/contact">Contact form</a>
        </p>
      </article>
    </div>
  </section>
  <CTA />
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const timeline = document.querySelector("[data-timeline]");
  if (timeline instanceof HTMLElement) {
    if (reduce) {
      timeline.classList.add("is-live");
    } else {
      const play = () => timeline.classList.add("is-live");
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          play();
          io.disconnect();
        },
        { threshold: 0.25, rootMargin: "0px 0px -8% 0px" },
      );
      io.observe(timeline);
      const rect = timeline.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.85 && rect.bottom > 0) play();
      window.setTimeout(play, 2200);
    }
  }
</script>
