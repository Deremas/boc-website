---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/common/Button.astro";
import CTA from "../components/common/CTA.astro";
import { company, digitalEthiopia, leadership, mission, org, story, teamGroups, timeline, values, vision } from "../data/company";
---

<BaseLayout
  title="About Blue Ocean Creatives | Blue Pixel Trading PLC, Addis Ababa"
  description="Founded in April 2023, Blue Ocean Creatives runs digital marketing and builds business systems for Ethiopian companies, with 23+ staff in Addis Ababa, Dire Dawa and Adama."
  image="/images/office/wide-20.jpg"
>
  <div class="container hero">
    <div>
      <p class="eyebrow">About</p>
      <h1>We help Ethiopian businesses run better and grow faster.</h1>
      <p class="lede">
        {company.legalName}, trading as {company.name}. Founded in {company.established}. {company.staff} people in Addis Ababa, Dire Dawa and Adama.
      </p>
    </div>
    <img class="frame-photo" src="/images/office/wide-20.jpg" alt="Blue Ocean Creatives team" width="1024" height="675" />
  </div>
  <section class="section-tint">
    <div class="container">
      <h2>Our story</h2>
      <div class="prose" style="max-width: 46rem; margin-top: 12px;">
        {story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="timeline" style="margin-top: 28px;">
        {timeline.map((item) => (
          <article class="card">
            <p class="eyebrow">{item.year}</p>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section>
    <div class="container split">
      <article class="card">
        <p class="eyebrow">Mission</p>
        <h2>{mission}</h2>
      </article>
      <article class="card card-dark">
        <p class="eyebrow">Vision</p>
        <h2>{vision}</h2>
      </article>
    </div>
    <div class="container why-grid" style="margin-top: 18px;">
      {values.map((value) => (
        <article class="card">
          <h3>{value.title}</h3>
          <p>{value.text}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section-tint">
    <div class="container">
      <h2>Leadership</h2>
      <div class="leader-grid" style="margin-top: 20px;">
        {leadership.map((person) => (
          <article class="leader-card">
            {person.image ? (
              <img src={person.image} alt={person.name} width="640" height="640" />
            ) : (
              <div class="avatar-fallback" aria-hidden="true">{person.name.split(" ").map((part) => part[0]).slice(0, 2).join("")}</div>
            )}
            <div>
              <h3>{person.name}</h3>
              <p>{person.role}</p>
              <p>{person.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <h2>How we are organised</h2>
      <div class="org" style="margin-top: 20px;">
        <span>{org.ceo}</span>
        <div class="org-row">
          {org.reports.map((role) => <span>{role}</span>)}
        </div>
        <div class="org-row">
          {org.wings.map((wing) => <span>{wing}</span>)}
        </div>
      </div>
      <div class="team-groups">
        {
          teamGroups.map((group) => (
            <div>
              <h3>{group.wing}</h3>
              <div class="role-grid">
                {group.people.map((person) => (
                  <article class:list={["role-card", { "role-card-full": "frame" in person && person.frame === "full" }]}>
                    {person.image ? (
                      <img src={person.image} alt={person.name} width="289" height="481" />
                    ) : (
                      <div class="role-photo" aria-hidden="true" />
                    )}
                    <strong>{person.name}</strong>
                    <p>{person.role}</p>
                  </article>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section-tint">
    <div class="container">
      <h2>Where we work</h2>
      <div class="location-grid" style="margin-top: 20px;">
        {company.locations.map((location) => (
          <article class="location-card">
            <p class="eyebrow">{location.staff} staff</p>
            <h3>{location.city}</h3>
            <p>{location.role}</p>
            <p>{location.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <div class="card card-dark">
        <p class="eyebrow">Digital Ethiopia 2030</p>
        <h2>Our contribution.</h2>
        <div class="service-grid" style="margin-top: 18px;">
          {digitalEthiopia.map((item) => (
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section-tint">
    <div class="container split">
      <div>
        <h2>Credentials</h2>
        <ul>
          <li>Registered name: {company.legalName}</li>
          <li>Trade name: {company.name}</li>
          <li>Established {company.established}</li>
        </ul>
        <div style="margin-top: 18px;">
          <Button href={company.profilePdf} variant="secondary" track="profile-download">Download company profile</Button>
        </div>
      </div>
      <article class="card">
        <h2>Join us</h2>
        <p>We’re growing. Send your CV to <a class="text-link" href={`mailto:${company.email}`}>{company.email}</a>.</p>
      </article>
    </div>
  </section>
  <CTA />
</BaseLayout>
