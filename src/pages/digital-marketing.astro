---
import BaseLayout from "../layouts/BaseLayout.astro";
import MarketingHero from "../components/marketing/MarketingHero.astro";
import MarketingServices from "../components/marketing/MarketingServices.astro";
import MarketingProcess from "../components/marketing/MarketingProcess.astro";
import ResultsTable from "../components/marketing/ResultsTable.astro";
import CreativeShowcase from "../components/marketing/CreativeShowcase.astro";
import CTA from "../components/common/CTA.astro";
import TestimonialCarousel from "../components/home/TestimonialCarousel";
import SectionHeading from "../components/common/SectionHeading.astro";
import { getCollection } from "astro:content";
import { healthClients, languageExamples } from "../data/services";
import { languages } from "../data/company";

const quoteOrder = ["apex", "peniel", "evolve", "ag-grace", "builders"];
const quotes = (await getCollection("testimonials"))
  .filter((entry) => entry.data.pages.includes("marketing"))
  .sort((a, b) => quoteOrder.indexOf(a.id) - quoteOrder.indexOf(b.id))
  .map((entry) => ({
    quote: entry.data.quote,
    name: entry.data.name,
    role: entry.data.role,
    company: entry.data.company,
  }));
---

<BaseLayout
  title="Social Media & Digital Marketing Agency in Ethiopia | Blue Ocean Creatives"
  description="50+ social media accounts managed. Content, video, hosts and paid ads in Amharic, Afaan Oromoo, Somali and Tigrigna. Proven results for health, education and consumer brands."
>
  <MarketingHero />
  <section class="proof-bar" aria-label="Marketing numbers">
    <div class="container proof-grid" style="grid-template-columns: repeat(4, minmax(0, 1fr));">
      <div><strong data-count="50+">50+</strong><span>Social media accounts</span></div>
      <div><strong data-count="37M+">37M+</strong><span>Views across four flagship accounts in 12 months</span></div>
      <div><strong data-count="5">5</strong><span>Content languages</span></div>
      <div><strong data-count="96K+">96K+</strong><span>Followers on our own TikTok and Instagram</span></div>
    </div>
  </section>
  <MarketingServices />
  <MarketingProcess />
  <ResultsTable />
  <section class="section-tint">
    <div class="container split">
      <div>
        <SectionHeading
          title="Speaking every audience’s language."
          text="Resident teams in Dire Dawa and Adama produce the work in the language people use."
        />
        <div class="chips">
          {languages.map((language) => <span class="chip">{language}</span>)}
        </div>
      </div>
      <ul class="lang-examples">
        {
          languageExamples.map((example) => (
            <li>
              <strong>{example.client}</strong>
              <span>{example.languages}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <section>
    <div class="container">
      <SectionHeading
        title="Health-sector experience."
        text="Health communication must be accurate, culturally appropriate and approved before it goes live."
      />
      <div class="result-grid logo-pair">
        {
          healthClients.map((client) => (
            <article class="card health-client">
              {"logo" in client && <img src={client.logo} alt="" />}
              <h3>{client.name}</h3>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <CreativeShowcase />
  <section class="section-tint">
    <div class="container">
      <SectionHeading title="From the reference letters." />
      <TestimonialCarousel client:visible items={quotes} interval={3000} />
    </div>
  </section>
  <CTA
    title="Tell us about your brand."
    text="We’ll send a proposal within two working days."
    primaryLabel="Get a marketing proposal"
    primaryHref="/contact"
  />
</BaseLayout>

<style>
  .lang-examples {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .lang-examples li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: 12px;
    border-bottom: 1px solid var(--color-line);
  }

  .lang-examples strong {
    color: var(--color-navy);
  }

  .health-client {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 14px;
  }

  .health-client img {
    width: 100%;
    height: 96px;
    object-fit: contain;
  }

  .health-client h3 {
    margin: 0;
  }

  a.health-client {
    text-decoration: none;
  }

  .lang-examples span {
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .proof-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>
